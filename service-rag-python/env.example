# ==============================================================================
# CIVIL-LEX Python RAG Service - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.
# NOTE: This service runs on your laptop and connects locally to your database.

# ------------------------------------------------------------------------------
# 1. PostgreSQL / pgvector Direct Database Connection
# ------------------------------------------------------------------------------
# [LOCAL ON LAPTOP]: Connects directly to local Supabase Postgres instance (port 54322)
POSTGRES_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ------------------------------------------------------------------------------
# 2. Supabase API Connection
# ------------------------------------------------------------------------------
# [LOCAL ON LAPTOP]: Connects directly to local Supabase API gateway (port 54321)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 3. LLM / Inference Service
# ------------------------------------------------------------------------------
# LM Studio or local inference server (default port 1234)
LM_STUDIO_URL=http://127.0.0.1:1234/v1

# Embedding model (optional, defaults to sentence-transformers/stsb-xlm-r-multilingual)
# EMBEDDING_MODEL_NAME=sentence-transformers/stsb-xlm-r-multilingual
