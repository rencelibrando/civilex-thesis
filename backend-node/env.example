# Backend Node Gateway Configuration
# Local default: 4000. Azure App Service automatically injects PORT (e.g., 80 or 8080).
PORT=4000

# Tunneled or Local Supabase URL
# When running on Azure, set this to your laptop's tunneled URL (e.g., https://your-tunnel-id.inc1.devtunnels.ms:54321 or cloudflared URL)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Python RAG Service URL
# When running on Azure, set this to your laptop's tunneled URL (e.g., https://your-tunnel-id-8000.inc1.devtunnels.ms or cloudflared URL)
RAG_SERVICE_URL=http://localhost:8000

# CORS Allowed Origins
# Comma-separated list of allowed frontend domains, e.g.:
# ALLOWED_ORIGINS=https://your-frontend.azurewebsites.net,http://localhost:3000
# Leave as '*' to allow all origins
ALLOWED_ORIGINS=*
