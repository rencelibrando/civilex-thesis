# ==============================================================================
# CIVIL-LEX Backend Node Gateway - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your values.

# ------------------------------------------------------------------------------
# 1. Server Port
# ------------------------------------------------------------------------------
# [LOCAL DEV]: Default is 4000.
# [AZURE DEPLOYMENT]: Azure App Service sets PORT automatically (e.g. 8080 or 80).
PORT=4000

# ------------------------------------------------------------------------------
# 2. Supabase Connection (Database, Storage & Auth)
# ------------------------------------------------------------------------------
# [LOCAL DEV]:
#   SUPABASE_URL=http://localhost:54321
#
# [AZURE DEPLOYMENT]:
#   Set to your laptop's tunneled URL for port 54321:
#   SUPABASE_URL=https://<tunnel-id>-54321.asse.devtunnels.ms
SUPABASE_URL=http://localhost:54321

# Keys can be obtained by running `npx supabase status` on your laptop
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 3. Python RAG Service Connection
# ------------------------------------------------------------------------------
# [LOCAL DEV]:
#   RAG_SERVICE_URL=http://localhost:8000
#
# [AZURE DEPLOYMENT]:
#   Set to your laptop's tunneled URL for port 8000:
#   RAG_SERVICE_URL=https://<tunnel-id>-8000.asse.devtunnels.ms
RAG_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 4. CORS Allowed Origins
# ------------------------------------------------------------------------------
# [LOCAL DEV]: Use '*' to allow local frontend on localhost:3000
# [AZURE DEPLOYMENT]:
#   Set to your Azure frontend URL, or '*' to allow all:
#   ALLOWED_ORIGINS=https://your-frontend.azurewebsites.net,https://your-app.azurestaticapps.net
ALLOWED_ORIGINS=*
