# Frontend Environment Variables Configuration

# Supabase Auth & Public Storage
# In local development: http://localhost:54321
# When deployed to Azure: point to your laptop's tunneled Supabase URL (e.g. https://your-tunnel-id-54321.inc1.devtunnels.ms or cloudflared URL)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend Node Gateway URL
# In local development: http://localhost:4000
# When deployed to Azure: point to your Azure Backend App Service URL, e.g. https://civilex-backend.azurewebsites.net
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
