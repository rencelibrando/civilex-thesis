
# CIVIL-LEX Frontend (Next.js) - Environment Configuration Template

# Copy this file to .env.local for local development.


# 1. Supabase Client Configuration (Auth & Storage)

# [LOCAL DEV]:
#   NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
#
# [AZURE DEPLOYMENT]:
#   Set to your laptop's tunneled URL for port 54321:
#   NEXT_PUBLIC_SUPABASE_URL=https://<tunnel-id>-54321.asse.devtunnels.ms
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here


# 2. Backend Node API Gateway URL

# [LOCAL DEV]:
#   NEXT_PUBLIC_API_URL=http://localhost:4000
#   NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
#
# [AZURE DEPLOYMENT]:
#   Set to your deployed Azure backend App Service URL:
#   NEXT_PUBLIC_API_URL=https://<your-backend-app-name>.azurewebsites.net
#   NEXT_PUBLIC_BACKEND_URL=https://<your-backend-app-name>.azurewebsites.net
    NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
